<Project Sdk="Microsoft.NET.Sdk">
  <!-- Draws the app icon (dev tool, not shipped). Vector shapes rendered
       separately at every size, so small sizes stay sharp, then packed
       into one .ico. Usage: dotnet run (project tools/IconGen, Release),
       arguments: square or circle, output .ico, preview folder. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
