<UserControl x:Class="StandbyAndTimer.Views.Cards.MemoryStatsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFont}" FontSize="13">
    <!-- Standby memory KPI + total / free split below. Binds to ClearableValue /
         TotalRamMb / FreeRamMb on MainViewModel.

         Three-row Grid (Auto / * / Auto): title pinned top, KPI vertically
         centered in the slack, Total/Free strip pinned to the bottom. The
         middle * row absorbs whatever extra height the sibling StandbyPurge
         card forces on this row, so the box never has a dead band at the
         bottom — content is distributed evenly through the full cell. -->
    <Border Style="{StaticResource SectionBorderStyle}"
            Padding="16,14"
            Margin="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- 0 Title -->
                <RowDefinition Height="*"/>     <!-- 1 KPI block (centered) -->
                <RowDefinition Height="Auto"/>  <!-- 2 Total / Free strip -->
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{DynamicResource Str_Card_StandbyTitle}"
                       Style="{StaticResource SectionLabelStyle}"/>

            <!-- What a purge in the selected mode would free now (MainViewModel
                 .ClearableMb); the tooltip compares all three modes. -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center"
                        Background="Transparent"
                        ToolTip="{Binding ClearableTip}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding ClearableValue}"
                               Style="{StaticResource KpiValueStyle}"/>
                    <TextBlock Text="{Binding ClearableUnit}"
                               FontSize="13"
                               VerticalAlignment="Bottom"
                               Margin="5,0,0,5"
                               Foreground="{DynamicResource AppFgDim}"/>
                </StackPanel>

                <TextBlock Text="{Binding ClearableLabel}"
                           FontSize="14"
                           Foreground="{DynamicResource AppFgDim}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource SeparatorBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- Three equal columns; each cell uses its outer StackPanel
                         alignment (Left / Center / Right) to anchor the label
                         and value to the same side, so the row visually breaks
                         into left|center|right thirds instead of three
                         left-flushed clumps. -->
                    <StackPanel Grid.Column="0" HorizontalAlignment="Left">
                        <TextBlock Text="{DynamicResource Str_Memory_TotalShort}"
                                   FontSize="10"
                                   Foreground="{DynamicResource AppFgDim}"
                                   HorizontalAlignment="Left"
                                   Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding TotalRamMb, StringFormat={}{0} MB}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Left"
                                   Foreground="{DynamicResource AccentText}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="{DynamicResource Str_Memory_FreeShort}"
                                   FontSize="10"
                                   Foreground="{DynamicResource AppFgDim}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding FreeRamMb, StringFormat={}{0} MB}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource AccentText}"/>
                    </StackPanel>
                    <!-- Purges: a button that opens the purge history
                         (PurgeHistoryOverlay); looks like the other cells,
                         with an accent underline on hover. -->
                    <Button Grid.Column="2"
                            HorizontalAlignment="Right"
                            Command="{Binding ShowPurgeHistoryCommand}"
                            ToolTip="{DynamicResource Str_Card_PurgesTip}"
                            Cursor="Hand"
                            Focusable="False">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <StackPanel Background="Transparent">
                                    <TextBlock Text="{DynamicResource Str_Memory_PurgesShort}"
                                               FontSize="10"
                                               Foreground="{DynamicResource AppFgDim}"
                                               HorizontalAlignment="Right"
                                               Margin="0,0,0,2"/>
                                    <TextBlock x:Name="count"
                                               Text="{Binding PurgeCount}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Right"
                                               Foreground="{DynamicResource AppFg}"/>
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="count" Property="Foreground" Value="{DynamicResource AccentText}"/>
                                        <Setter TargetName="count" Property="TextDecorations" Value="Underline"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
