<UserControl x:Class="StandbyAndTimer.Views.Cards.TitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             FontFamily="{StaticResource AppFont}" FontSize="13">

    <!-- Custom title bar — the window has WindowStyle=None, so we render
         caption, app name, admin badge, and About/Minimize/Close buttons
         ourselves (Settings is a tab now, not a title-bar button).
         shell:WindowChrome on MainWindow makes the bar draggable; the
         action buttons opt out via IsHitTestVisibleInChrome. -->
    <!-- Same tone as the window (WhichGPU-style): the segment tab strip right
         below already separates chrome from content, a divider line here
         just doubled it. -->
    <Border Background="{DynamicResource AppBg}"
            Height="36">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Left: status dot + app name -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Margin="14,0,0,0"
                        VerticalAlignment="Center">
                <Ellipse Width="9" Height="9"
                         Fill="{DynamicResource SuccessColor}"
                         VerticalAlignment="Center"
                         Margin="0,0,9,0"/>
                <TextBlock Text="StandbyAndTimer"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppFg}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Right: admin badge + window controls -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Margin="0,0,4,0"
                        VerticalAlignment="Center"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">

                <!-- Administrator badge = button: opens System settings
                     (SystemOverlay), where settings that change Windows go. -->
                <Button Command="{Binding SystemSettings.OpenCommand}"
                        ToolTip="{DynamicResource Str_TitleBar_AdminTip}"
                        Cursor="Hand"
                        Focusable="False"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="badge" Style="{StaticResource SuccessBadgeStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M5,0 L5,3 L9,3 L9,8 L1,8 L1,3 L5,3 M3,3 L3,1.5 A2,2 0 0 1 7,1.5 L7,3"
                                          Stroke="{DynamicResource AccentText}"
                                          StrokeThickness="1"
                                          Width="10" Height="9"
                                          Stretch="Uniform"
                                          VerticalAlignment="Center"
                                          Margin="0,0,5,0"/>
                                    <TextBlock Text="{DynamicResource Str_TitleBar_Admin}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentText}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="badge" Property="Background" Value="{DynamicResource AccentSubtle}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Style="{StaticResource TitleBarIconButtonStyle}"
                        Content="?"
                        FontSize="13"
                        Command="{Binding ShowAboutCommand}"
                        ToolTip="About"/>

                <Button Style="{StaticResource TitleBarIconButtonStyle}"
                        Content="—"
                        FontSize="11"
                        Click="OnMinimizeClick"
                        ToolTip="Minimize"/>

                <Button Style="{StaticResource TitleBarCloseButtonStyle}"
                        Content="✕"
                        FontSize="12"
                        Click="OnCloseClick"
                        ToolTip="Close"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
