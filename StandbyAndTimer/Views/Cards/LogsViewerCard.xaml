<UserControl x:Class="StandbyAndTimer.Views.Cards.LogsViewerCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFont}" FontSize="13">

    <!-- Recent-logs viewer on the Settings page. Inherits SettingsViewModel
         as DataContext (RecentLogs). The section header ("Recent logs" +
         Refresh) lives on the page's label row so this card's top edge lines
         up with the Hotkeys card next to it; this control is only the box,
         which stretches to whatever height the page row gives it. -->

    <!-- Tail box. TextWrapping=Wrap so long lines break onto the next
         visible row instead of disappearing off the right; the on-disk
         log keeps original line shape. Background uses AppBg (darkest
         tone in the palette) for visible contrast against the cards,
         Foreground=AppFg for full readability of 10.5 pt Consolas.
         Corner radius matches the settings cards. -->
    <Border Background="{DynamicResource AppBg}"
            BorderBrush="{DynamicResource BorderColor}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusLarge}">
        <!-- EdgeMode=Aliased: on the hardware render path the clip edges
             of this ScrollViewer and of the TextBox's own content host
             drew a faint grey rectangle around the log text (dark theme).
             Plain text inside, so nothing here needs geometry AA. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      RenderOptions.EdgeMode="Aliased"
                      Padding="8,6">
            <TextBox Text="{Binding RecentLogs, Mode=OneWay}"
                     IsReadOnly="True"
                     Background="Transparent"
                     Foreground="{DynamicResource AppFg}"
                     BorderThickness="0"
                     FontFamily="Consolas"
                     FontSize="10.5"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"/>
        </ScrollViewer>
    </Border>
</UserControl>
