<UserControl x:Class="StandbyAndTimer.Views.Cards.TimerCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:StandbyAndTimer.Core.Models"
             FontFamily="{StaticResource AppFont}" FontSize="13">
    <UserControl.Resources>
        <!-- Lock toggle pill, cycling on click. Tag = TimerLock (enum).
             Unlocked: muted outline, open shackle, "UNLOCKED"; Locked and
             InGame: accent outline, closed shackle, "LOCKED" / "IN GAME".
             Explicit TextBlock/Path colours so the app-level implicit
             TextBlock style can't override them. -->
        <Style x:Key="TimerLockButtonStyle" TargetType="Button">
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ToolTip"          Value="{DynamicResource Str_Card_TimerLockTipOff}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="Transparent"
                                BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusSmall}"
                                Padding="7,2"
                                SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="icon"
                                      Data="M1,3 L9,3 L9,8 L1,8 Z M3,3 L3,1.5 A2,2 0 0 1 7,1.5"
                                      Stroke="{DynamicResource AppFgDim}"
                                      StrokeThickness="1"
                                      Width="10" Height="9"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Margin="0,0,5,0"/>
                                <TextBlock x:Name="label"
                                           Text="{DynamicResource Str_Card_TimerUnlocked}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppFgDim}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="{x:Static models:TimerLockMode.Locked}">
                                <Setter TargetName="bd"    Property="BorderBrush" Value="{DynamicResource AccentText}"/>
                                <Setter TargetName="icon"  Property="Data"        Value="M5,0 L5,3 L9,3 L9,8 L1,8 L1,3 L5,3 M3,3 L3,1.5 A2,2 0 0 1 7,1.5 L7,3"/>
                                <Setter TargetName="icon"  Property="Stroke"      Value="{DynamicResource AccentText}"/>
                                <Setter TargetName="label" Property="Text"        Value="{DynamicResource Str_Card_TimerLocked}"/>
                                <Setter TargetName="label" Property="Foreground"  Value="{DynamicResource AccentText}"/>
                                <Setter Property="ToolTip"                        Value="{DynamicResource Str_Card_TimerLockTipOn}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="{x:Static models:TimerLockMode.InGame}">
                                <Setter TargetName="bd"    Property="BorderBrush" Value="{DynamicResource AccentText}"/>
                                <Setter TargetName="icon"  Property="Data"        Value="M5,0 L5,3 L9,3 L9,8 L1,8 L1,3 L5,3 M3,3 L3,1.5 A2,2 0 0 1 7,1.5 L7,3"/>
                                <Setter TargetName="icon"  Property="Stroke"      Value="{DynamicResource AccentText}"/>
                                <Setter TargetName="label" Property="Text"        Value="{DynamicResource Str_Card_TimerInGame}"/>
                                <Setter TargetName="label" Property="Foreground"  Value="{DynamicResource AccentText}"/>
                                <Setter Property="ToolTip"                        Value="{DynamicResource Str_Card_TimerLockTipInGame}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Hero card — actual timer resolution + toggle button + start-up lock.
         Binds to TimerActive / ActualTimerMs / TimerButtonLabel /
         ToggleTimerResolutionCommand / TimerLocked / ToggleTimerLockCommand
         on MainViewModel. -->
    <!-- Margin 0: MainWindow's spacer row separates it from the memory card,
         and the card is stretched to half the column. Title at the top,
         button at the bottom, the value centred in whatever is left. -->
    <Border Style="{StaticResource SectionBorderStyle}" Padding="16,14" Margin="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- MinHeight keeps the title row at the pill's height whatever
                 its state, so toggling never makes the card "breathe". -->
            <Grid Grid.Row="0" Margin="0,0,0,4" MinHeight="24">
                <TextBlock Text="{DynamicResource Str_Card_TimerTitle}"
                           Style="{StaticResource SectionLabelStyle}"
                           VerticalAlignment="Center"/>
                <!-- Locked = the timer turns on by itself at every app start.
                     Always visible now (it used to be a passive badge shown
                     only while the timer ran). -->
                <Button HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Style="{StaticResource TimerLockButtonStyle}"
                        Tag="{Binding TimerLock}"
                        Command="{Binding ToggleTimerLockCommand}"/>
            </Grid>

            <!-- Value above, full-width button below: in the landscape
                 three-column layout the card is ~238 px wide, too narrow
                 for the 56 px hero value and a 120 px button side by side. -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding ActualTimerMs, StringFormat={}{0:F2}}"
                           Style="{StaticResource HeroValueStyle}"/>
                <TextBlock Text="ms"
                           FontSize="18"
                           FontWeight="Light"
                           Foreground="{DynamicResource AppFgDim}"
                           VerticalAlignment="Bottom"
                           Margin="6,0,0,12"/>
            </StackPanel>

            <Button Grid.Row="2"
                    Content="{Binding TimerButtonLabel}"
                    Command="{Binding ToggleTimerResolutionCommand}"
                    Style="{StaticResource DarkButtonStyle}"
                    Height="34"
                    HorizontalAlignment="Stretch"
                    FontSize="13"/>
        </Grid>
    </Border>
</UserControl>
