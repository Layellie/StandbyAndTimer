<UserControl x:Class="StandbyAndTimer.Views.Cards.StatusBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFont}" FontSize="13">

    <!-- Bottom status strip under both tabs: live status message (left) +
         app version (right, WhichGPU-style). Binds to StatusMessage and
         Settings.CurrentVersion on MainViewModel. The "v" prefix matches the
         GitHub release tag format so it reads the same as the release page. -->
    <Border BorderBrush="{DynamicResource SeparatorBrush}"
            BorderThickness="0,1,0,0"
            Padding="2,8,2,0"
            Margin="0,10,0,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{Binding StatusMessage}"
                       FontSize="11"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource AppFgDim}"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding Settings.CurrentVersion, StringFormat=v{0}}"
                       FontSize="11"
                       Foreground="{DynamicResource AppFgDim}"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"/>
        </Grid>
    </Border>
</UserControl>
