<UserControl x:Class="StandbyAndTimer.Views.Cards.StandbyPurgeCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFont}" FontSize="13">

    <!-- Purge controls: count, AUTO PURGE master toggle, two thresholds, and
         the manual purge button. Binds to PurgeCount / AutoPurgeEnabled /
         StandbyLimitMb / FreeLimitMb / ManualPurgeCommand on MainViewModel. -->
    <Border Style="{StaticResource SectionBorderStyle}"
            Padding="16,14"
            Margin="0">
        <!-- Settings stack on top, manual purge button pinned to the bottom
             edge so it lines up with the bottom of the sibling columns. -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <TextBlock Text="{DynamicResource Str_Card_PurgeTitle}"
                           Style="{StaticResource SectionLabelStyle}"
                           Margin="0,0,0,8"/>

                <!-- Idle-only gate (sits ABOVE the master toggle).
                     Greyed when AUTO PURGE is off because the gate has no
                     effect without the master switch. The right-side minutes
                     input mirrors the Standby/Free limit input pattern
                     (Width=64, Height=26, FontSize=12) for visual symmetry; 64 rather than
                     78 so "Sadece boştayken" fits the ~238 px landscape column. -->
                <Grid Margin="0,0,0,8" IsEnabled="{Binding AutoPurgeEnabled}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="64"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0"
                              Content="{DynamicResource Str_Purge_IdleOnlyLabel}"
                              IsChecked="{Binding AutoPurgeIdleOnly}"
                              Style="{StaticResource DarkCheckBoxStyle}"
                              VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding IdleThresholdMinutes, UpdateSourceTrigger=LostFocus}"
                             Style="{StaticResource InputTextBoxStyle}"
                             Height="26" FontSize="12"
                             IsEnabled="{Binding AutoPurgeIdleOnly}"/>
                </Grid>

                <!-- Only while a listed game runs. Excludes "only when idle"
                     (the view model clears the other one), since nobody is
                     idle mid-game. Same AUTO PURGE gate as the row above. -->
                <CheckBox Content="{DynamicResource Str_Purge_OnlyInGamesLabel}"
                          IsChecked="{Binding AutoPurgeOnlyInGames}"
                          IsEnabled="{Binding AutoPurgeEnabled}"
                          ToolTip="{DynamicResource Str_Purge_OnlyInGamesTip}"
                          Style="{StaticResource DarkCheckBoxStyle}"
                          Margin="0,0,0,10"/>

                <!-- AUTO PURGE master toggle — when off, both thresholds are
                     ignored and no automatic purge ever fires. -->
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="{DynamicResource Str_Card_AutoPurgeLabel}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppFgDim}"
                               VerticalAlignment="Center"/>
                    <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding AutoPurgeEnabled}"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center">
                        <CheckBox.Content>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{DynamicResource Str_Card_GameModeOff}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AutoPurgeEnabled}" Value="True">
                                                <Setter Property="Text" Value="{DynamicResource Str_Card_GameModeOn}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </CheckBox.Content>
                    </CheckBox>
                </Grid>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="64"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{DynamicResource Str_Purge_StandbyLimitLabel}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AppFgDim}"
                               Margin="0,0,6,0"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding StandbyLimitMb, UpdateSourceTrigger=LostFocus}"
                             Style="{StaticResource InputTextBoxStyle}"
                             Height="26" FontSize="12"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="64"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{DynamicResource Str_Purge_FreeLimitLabel}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AppFgDim}"
                               Margin="0,0,6,0"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding FreeLimitMb, UpdateSourceTrigger=LostFocus}"
                             Style="{StaticResource InputTextBoxStyle}"
                             Height="26" FontSize="12"/>
                </Grid>

                <!-- Light purge: applies to every purge (button, auto,
                     hotkey, tray), so it sits outside the AUTO PURGE group. -->
                <Border BorderBrush="{DynamicResource SeparatorBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="0,10,0,0">
                    <StackPanel>
                        <CheckBox Content="{DynamicResource Str_Purge_LightLabel}"
                                  IsChecked="{Binding LightPurge}"
                                  ToolTip="{DynamicResource Str_Purge_LightTip}"
                                  Style="{StaticResource DarkCheckBoxStyle}"/>
                        <TextBlock Text="{DynamicResource Str_Purge_LightDesc}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource AppFgDim}"
                                   Margin="23,2,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Button Grid.Row="1"
                    Content="{DynamicResource Str_Purge_Button}"
                    Command="{Binding ManualPurgeCommand}"
                    Style="{StaticResource DarkButtonStyle}"
                    Height="34"
                    HorizontalAlignment="Stretch"/>
        </Grid>
    </Border>
</UserControl>
