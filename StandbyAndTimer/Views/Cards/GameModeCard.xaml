<UserControl x:Class="StandbyAndTimer.Views.Cards.GameModeCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:StandbyAndTimer.Views.Converters"
             FontFamily="{StaticResource AppFont}" FontSize="13">
    <UserControl.Resources>
        <conv:GameIconConverter x:Key="GameIconConv"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <!-- Game Mode toggle + executable list with drag-drop and add/remove
         buttons. Binds to GameModeEnabled / Games / SelectedGame /
         RemoveGameCommand / AddGameCommand on MainViewModel. Dropped
         file paths are forwarded via the GameDropped event so the host
         can call MainViewModel.AddGameFromPath. -->
    <!-- Full-height column card: the list row is * so the game list fills
         whatever the landscape layout gives the column. -->
    <Border Style="{StaticResource SectionBorderStyle}" Padding="16,14" Margin="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- 0 Title + toggle -->
                <RowDefinition Height="Auto"/>  <!-- 1 Description -->
                <RowDefinition Height="*"/>     <!-- 2 Game list -->
                <RowDefinition Height="Auto"/>  <!-- 3 Drop hint -->
                <RowDefinition Height="Auto"/>  <!-- 4 DEL / ADD -->
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,4">
                <TextBlock Text="{DynamicResource Str_Card_GameModeTitle}"
                           Style="{StaticResource SectionLabelStyle}"
                           VerticalAlignment="Center"/>
                <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                          IsChecked="{Binding GameModeEnabled}"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center">
                    <CheckBox.Content>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{DynamicResource Str_Card_GameModeOff}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GameModeEnabled}" Value="True">
                                            <Setter Property="Text" Value="{DynamicResource Str_Card_GameModeOn}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </CheckBox.Content>
                </CheckBox>
            </Grid>

            <TextBlock Grid.Row="1"
                       Text="{DynamicResource Str_Card_GameModeDesc}"
                       FontSize="11"
                       Foreground="{DynamicResource AppFgDim}"
                       Margin="0,0,0,10"/>

            <ListBox x:Name="GamesList"
                     Grid.Row="2"
                     ItemsSource="{Binding Games}"
                     SelectedItem="{Binding SelectedGame}"
                     Style="{StaticResource GameListBoxStyle}"
                     Margin="0,0,0,8"
                     AllowDrop="True"
                     DragEnter="GamesList_DragEnter"
                     DragOver="GamesList_DragEnter"
                     Drop="GamesList_Drop"
                     ToolTip="{DynamicResource Str_Game_DropHint}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- Name trims; the AUTO tag (fullscreen detection
                             added it) stays pinned to the right edge. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="{Binding ExecutablePath, Converter={StaticResource GameIconConv}}"
                                   Width="16" Height="16"
                                   Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding DisplayName}"
                                       ToolTip="{Binding ExecutablePath}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                            <Border Grid.Column="2"
                                    Style="{StaticResource MutedBadgeStyle}"
                                    Padding="5,0"
                                    Margin="6,0,0,0"
                                    ToolTip="{DynamicResource Str_Game_AutoTagTip}"
                                    Visibility="{Binding AutoAdded, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{DynamicResource Str_Game_AutoTag}"
                                           FontSize="9" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppFgDim}"/>
                            </Border>
                            <!-- ⚙: a per-game switch is off (priority left
                                 alone, or auto purge paused). A glyph, not a
                                 text badge: next to AUTO a second badge left
                                 the game name ~60 px. -->
                            <TextBlock Grid.Column="3"
                                       Text="⚙"
                                       FontSize="12"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource AppFgDim}"
                                       ToolTip="{DynamicResource Str_Game_CustomTagTip}"
                                       Visibility="{Binding HasCustomRules, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Row 3 shows the drop hint while nothing is selected, and the
                 selected game's own switches once a row is picked (same
                 space, so the list does not shrink). -->
            <TextBlock Grid.Row="3"
                       Text="{DynamicResource Str_Game_DropHint}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource AppFgDim}"
                       Margin="0,0,0,8">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedGame}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <StackPanel Grid.Row="3" Margin="0,0,0,8">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedGame}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <CheckBox Content="{DynamicResource Str_Game_BoostLabel}"
                          IsChecked="{Binding SelectedGameBoost}"
                          ToolTip="{DynamicResource Str_Game_BoostTip}"
                          Style="{StaticResource DarkCheckBoxStyle}"
                          Margin="0,0,0,6"/>
                <CheckBox Content="{DynamicResource Str_Game_AutoPurgeLabel}"
                          IsChecked="{Binding SelectedGameAutoPurge}"
                          ToolTip="{DynamicResource Str_Game_AutoPurgeTip}"
                          Style="{StaticResource DarkCheckBoxStyle}"/>
            </StackPanel>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="{DynamicResource Str_Game_Del}"
                        Command="{Binding RemoveGameCommand}"
                        Style="{StaticResource GhostButtonStyle}"
                        Height="34"/>
                <Button Grid.Column="2"
                        Content="{DynamicResource Str_Game_Add}"
                        Command="{Binding AddGameCommand}"
                        Style="{StaticResource DarkButtonStyle}"
                        Height="34"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
