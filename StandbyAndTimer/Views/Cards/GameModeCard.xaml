<UserControl x:Class="StandbyAndTimer.Views.Cards.GameModeCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:StandbyAndTimer.Views.Converters"
             FontFamily="{StaticResource AppFont}" FontSize="13">
    <UserControl.Resources>
        <conv:GameIconConverter x:Key="GameIconConv"/>
    </UserControl.Resources>

    <!-- Game Mode toggle + executable list with drag-drop and add/remove
         buttons. Binds to GameModeEnabled / Games / SelectedGame /
         RemoveGameCommand / AddGameCommand on MainViewModel. Dropped
         file paths are forwarded via the GameDropped event so the host
         can call MainViewModel.AddGameFromPath. -->
    <!-- Full-height column card: the list row is * so the game list fills
         whatever the landscape layout gives the column. -->
    <Border Style="{StaticResource SectionBorderStyle}" Padding="16,14" Margin="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- 0 Title + toggle -->
                <RowDefinition Height="Auto"/>  <!-- 1 Description -->
                <RowDefinition Height="*"/>     <!-- 2 Game list -->
                <RowDefinition Height="Auto"/>  <!-- 3 Drop hint -->
                <RowDefinition Height="Auto"/>  <!-- 4 DEL / ADD -->
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,4">
                <TextBlock Text="{DynamicResource Str_Card_GameModeTitle}"
                           Style="{StaticResource SectionLabelStyle}"
                           VerticalAlignment="Center"/>
                <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                          IsChecked="{Binding GameModeEnabled}"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center">
                    <CheckBox.Content>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{DynamicResource Str_Card_GameModeOff}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GameModeEnabled}" Value="True">
                                            <Setter Property="Text" Value="{DynamicResource Str_Card_GameModeOn}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </CheckBox.Content>
                </CheckBox>
            </Grid>

            <TextBlock Grid.Row="1"
                       Text="{DynamicResource Str_Card_GameModeDesc}"
                       FontSize="11"
                       Foreground="{DynamicResource AppFgDim}"
                       Margin="0,0,0,10"/>

            <ListBox x:Name="GamesList"
                     Grid.Row="2"
                     ItemsSource="{Binding Games}"
                     SelectedItem="{Binding SelectedGame}"
                     Style="{StaticResource GameListBoxStyle}"
                     Margin="0,0,0,8"
                     AllowDrop="True"
                     DragEnter="GamesList_DragEnter"
                     DragOver="GamesList_DragEnter"
                     Drop="GamesList_Drop"
                     ToolTip="{DynamicResource Str_Game_DropHint}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding ExecutablePath, Converter={StaticResource GameIconConv}}"
                                   Width="16" Height="16"
                                   Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Own row: next to two buttons the ~238 px column left the
                 hint about 70 px and it got clipped. -->
            <TextBlock Grid.Row="3"
                       Text="{DynamicResource Str_Game_DropHint}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource AppFgDim}"
                       Margin="0,0,0,8"/>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="{DynamicResource Str_Game_Del}"
                        Command="{Binding RemoveGameCommand}"
                        Style="{StaticResource GhostButtonStyle}"
                        Height="34"/>
                <Button Grid.Column="2"
                        Content="{DynamicResource Str_Game_Add}"
                        Command="{Binding AddGameCommand}"
                        Style="{StaticResource DarkButtonStyle}"
                        Height="34"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
