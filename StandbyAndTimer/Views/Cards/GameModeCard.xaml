<UserControl x:Class="StandbyAndTimer.Views.Cards.GameModeCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:StandbyAndTimer.Views.Converters"
             FontFamily="{StaticResource AppFont}" FontSize="13">
    <UserControl.Resources>
        <conv:GameIconConverter x:Key="GameIconConv"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Menu entries: the enum value shown as a DynamicResource string,
             so an open card follows a language change. -->
        <DataTemplate x:Key="GamePriorityItem">
            <TextBlock Foreground="{DynamicResource InputFg}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="{DynamicResource Str_GamePriority_High}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding}" Value="AboveNormal">
                                <Setter Property="Text" Value="{DynamicResource Str_GamePriority_AboveNormal}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding}" Value="Unchanged">
                                <Setter Property="Text" Value="{DynamicResource Str_GamePriority_Unchanged}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>
        <DataTemplate x:Key="PurgeOnceItem">
            <TextBlock Foreground="{DynamicResource InputFg}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="{DynamicResource Str_PurgeOnce_Off}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding}" Value="AtStart">
                                <Setter Property="Text" Value="{DynamicResource Str_PurgeOnce_AtStart}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding}" Value="AtExit">
                                <Setter Property="Text" Value="{DynamicResource Str_PurgeOnce_AtExit}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding}" Value="Both">
                                <Setter Property="Text" Value="{DynamicResource Str_PurgeOnce_Both}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>

        <!-- A label + small menu row, as tall as a checkbox row next to it. -->
        <Style x:Key="GameRuleComboStyle" TargetType="ComboBox" BasedOn="{StaticResource SettingsComboBoxStyle}">
            <Setter Property="Grid.Column"       Value="1"/>
            <!-- Fits the longest entry (Normalin üstü, 75 px at 12 px) plus
                 the arrow; the label keeps a 6 px gap. -->
            <Setter Property="Width"             Value="110"/>
            <Setter Property="Height"            Value="24"/>
            <Setter Property="Margin"            Value="6,0,0,0"/>
            <Setter Property="FontSize"          Value="12"/>
            <Setter Property="Padding"           Value="8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Style.Triggers>
                <!-- Greyed like the checkboxes beside it (no game picked, or
                     Game Mode off for Priority). -->
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GameRuleLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight"        Value="SemiBold"/>
            <Setter Property="Foreground"        Value="{DynamicResource AppFg}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming"      Value="CharacterEllipsis"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- Game Mode toggle + executable list with drag-drop and add/remove/scan
         buttons. Binds to GameModeEnabled / Games / SelectedGame /
         RemoveGameCommand / OpenInstalledGamesCommand / AddGameCommand on MainViewModel. -->
    <Border Style="{StaticResource SectionBorderStyle}" Padding="16,14" Margin="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- 0 Title + toggle -->
                <RowDefinition Height="*"/>     <!-- 1 Game list -->
                <RowDefinition Height="Auto"/>  <!-- 2 Per-game switches -->
                <RowDefinition Height="Auto"/>  <!-- 3 DEL / SCAN / ADD -->
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="{DynamicResource Str_Card_GameModeTitle}"
                           Style="{StaticResource SectionLabelStyle}"
                           VerticalAlignment="Center"/>
                <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                          IsChecked="{Binding GameModeEnabled}"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center">
                    <CheckBox.Content>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{DynamicResource Str_Card_GameModeOff}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GameModeEnabled}" Value="True">
                                            <Setter Property="Text" Value="{DynamicResource Str_Card_GameModeOn}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </CheckBox.Content>
                </CheckBox>
            </Grid>

            <ListBox x:Name="GamesList"
                     Grid.Row="1"
                     ItemsSource="{Binding Games}"
                     SelectedItem="{Binding SelectedGame}"
                     Style="{StaticResource GameListBoxStyle}"
                     Margin="0,0,0,8"
                     AllowDrop="True"
                     DragEnter="GamesList_DragEnter"
                     DragOver="GamesList_DragEnter"
                     Drop="GamesList_Drop"
                     MouseDoubleClick="GamesList_MouseDoubleClick"
                     ToolTip="{DynamicResource Str_Game_ListTip}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- Name trims; the AUTO tag (fullscreen detection
                             added it) stays pinned to the right edge. -->
                        <Grid Background="Transparent"
                              Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}">
                            <Grid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{DynamicResource Str_Game_MenuLaunch}"
                                              Command="{Binding PlacementTarget.Tag.LaunchSelectedGameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="{DynamicResource Str_Game_MenuOpenFolder}"
                                              Command="{Binding PlacementTarget.Tag.OpenGameFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="{DynamicResource Str_Game_MenuRemove}"
                                              Command="{Binding PlacementTarget.Tag.RemoveSpecificGameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                </ContextMenu>
                            </Grid.ContextMenu>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="{Binding ExecutablePath, Converter={StaticResource GameIconConv}}"
                                   Width="16" Height="16"
                                   Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding DisplayName}"
                                       ToolTip="{Binding ExecutablePath}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                            <Border Grid.Column="2"
                                    Style="{StaticResource MutedBadgeStyle}"
                                    Padding="5,0"
                                    Margin="6,0,0,0"
                                    ToolTip="{DynamicResource Str_Game_AutoTagTip}"
                                    Visibility="{Binding AutoAdded, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{DynamicResource Str_Game_AutoTag}"
                                           FontSize="9" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppFgDim}"/>
                            </Border>
                            <!-- ⚙: a per-game switch is off (priority left
                                 alone, or auto purge paused). A glyph, not a
                                 text badge: next to AUTO a second badge left
                                 the game name ~60 px. -->
                            <TextBlock Grid.Column="3"
                                       Text="⚙"
                                       FontSize="12"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource AppFgDim}"
                                       ToolTip="{DynamicResource Str_Game_CustomTagTip}"
                                       Visibility="{Binding HasCustomRules, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- The drag-and-drop hint, inside the empty list: it took a row
                 of its own before; the list tooltip says it too. -->
            <TextBlock Grid.Row="1"
                       Text="{DynamicResource Str_Game_DropHint}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="16,0,16,8"
                       IsHitTestVisible="False"
                       Foreground="{DynamicResource AppFgDim}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Games.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- The selected game's own rules. Always shown so the user
                 sees they exist; greyed (like DEL) until a row is picked,
                 showing the defaults (High priority, auto purge on, no purge
                 once). Tooltips still open while greyed so the rules explain
                 themselves. -->
            <StackPanel Grid.Row="2" Margin="0,0,0,8">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedGame}" Value="{x:Null}">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <!-- Priority is Game Mode's job: greyed while Game Mode is
                     off (the other rules work without it). -->
                <Grid Margin="0,0,0,6"
                      IsEnabled="{Binding GameModeEnabled}"
                      ToolTip="{DynamicResource Str_Game_PriorityTip}"
                      ToolTipService.ShowOnDisabled="True"
                      Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Str_Game_PriorityLabel}"
                               Style="{StaticResource GameRuleLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding GamePriorities}"
                              SelectedItem="{Binding SelectedGamePriority}"
                              ItemTemplate="{StaticResource GamePriorityItem}"
                              Style="{StaticResource GameRuleComboStyle}"/>
                </Grid>
                <CheckBox Content="{DynamicResource Str_Game_AutoPurgeLabel}"
                          IsChecked="{Binding SelectedGameAutoPurge}"
                          ToolTip="{DynamicResource Str_Game_AutoPurgeTip}"
                          ToolTipService.ShowOnDisabled="True"
                          Style="{StaticResource DarkCheckBoxStyle}"
                          Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,6"
                      ToolTip="{DynamicResource Str_Game_PurgeOnceTip}"
                      ToolTipService.ShowOnDisabled="True"
                      Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Str_Game_PurgeOnceLabel}"
                               Style="{StaticResource GameRuleLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding PurgeOnceOptions}"
                              SelectedItem="{Binding SelectedGamePurgeOnce}"
                              ItemTemplate="{StaticResource PurgeOnceItem}"
                              Style="{StaticResource GameRuleComboStyle}"/>
                </Grid>
                <CheckBox Content="{DynamicResource Str_Game_TimerLabel}"
                          IsChecked="{Binding SelectedGameTimerInGame}"
                          ToolTip="{DynamicResource Str_Game_TimerTip}"
                          ToolTipService.ShowOnDisabled="True"
                          Style="{StaticResource DarkCheckBoxStyle}"/>
            </StackPanel>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="{DynamicResource Str_Game_Del}"
                        Command="{Binding RemoveGameCommand}"
                        Style="{StaticResource GhostButtonStyle}"
                        Padding="4,5"
                        Height="34"/>
                <Button Grid.Column="2"
                        Content="{DynamicResource Str_Game_Scan}"
                        Command="{Binding OpenInstalledGamesCommand}"
                        ToolTip="{DynamicResource Str_Game_ScanTip}"
                        Style="{StaticResource GhostButtonStyle}"
                        Padding="4,5"
                        Height="34"/>
                <Button Grid.Column="4"
                        Content="{DynamicResource Str_Game_Add}"
                        Command="{Binding AddGameCommand}"
                        Style="{StaticResource DarkButtonStyle}"
                        Padding="4,5"
                        Height="34"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
