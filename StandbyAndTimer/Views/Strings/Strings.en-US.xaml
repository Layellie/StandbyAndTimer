    <sys:String x:Key="Str_Card_TimerLocked">LOCKED</sys:String>
    <sys:String x:Key="Str_Card_TimerUnlocked">UNLOCKED</sys:String>
    <sys:String x:Key="Str_Card_TimerInGame">IN GAME</sys:String>
