    <!-- About dialog -->
    <sys:String x:Key="Str_About_Title">About &amp; Usage Guide</sys:String>
    <sys:String x:Key="Str_About_Subtitle">System optimization tool</sys:String>
    <sys:String x:Key="Str_About_Feature1">Locks the system timer to 0.5 ms to cut input latency.</sys:String>
    <sys:String x:Key="Str_About_Feature2">Purges the standby memory list automatically or on demand.</sys:String>
    <sys:String x:Key="Str_About_Feature3">Game Mode: High priority and all CPU cores for the games in the list.</sys:String>
    <sys:String x:Key="Str_About_ThresholdsTitle">RECOMMENDED PURGE THRESHOLDS</sys:String>
    <sys:String x:Key="Str_About_ColRam">RAM</sys:String>
    <sys:String x:Key="Str_About_ColList">List at least</sys:String>
    <sys:String x:Key="Str_About_ColFree">Free below</sys:String>
    <sys:String x:Key="Str_About_Developer">Developer: LAYE77IE</sys:String>
    <sys:String x:Key="Str_About_Close">Close</sys:String>

    <!-- Single instance guard -->
    <sys:String x:Key="Str_AlreadyRunning" xml:space="preserve">Application is already running in the background.&#x0a;Look for the icon in the system tray.</sys:String>

    <!-- Close confirmation overlay -->
    <sys:String x:Key="Str_Close_Title">Close Application</sys:String>
    <sys:String x:Key="Str_Close_Message">The application can keep running in the system tray and continue optimizing your system.</sys:String>
    <sys:String x:Key="Str_Close_Minimize">Run in Background</sys:String>
    <sys:String x:Key="Str_Close_Exit">Exit Completely</sys:String>

    <!-- First-run wizard -->
    <sys:String x:Key="Str_Wizard_Title">Welcome to StandbyAndTimer</sys:String>
    <sys:String x:Key="Str_Wizard_Body" xml:space="preserve">Quick 30-second tour:&#x0a;&#x0a;1. Press TIMER to set the system clock to 0.5 ms — lower input lag, smoother audio. To have it turn on at every start, click UNLOCKED on the Timer card to lock it.&#x0a;&#x0a;2. AUTO PURGE is OFF by default. Turn it on and set thresholds only if your standby cache regularly bloats during games. Most people don't need it.&#x0a;&#x0a;3. Drag a game .exe into the Game Mode list to give it High priority + full CPU affinity when it launches. Games you play fullscreen are added on their own, tagged AUTO.&#x0a;&#x0a;Everything runs from the tray — closing the window keeps it alive.</sys:String>
    <sys:String x:Key="Str_Wizard_Finish">Got it</sys:String>

    <!-- Crash reporter -->
    <sys:String x:Key="Str_Crash_Title">Something went wrong</sys:String>
    <sys:String x:Key="Str_Crash_Body">StandbyAndTimer hit an unhandled error. The system timer has been restored. If you can reproduce this, please open an issue on GitHub — it really helps.</sys:String>
    <sys:String x:Key="Str_Crash_CopyDetails">Copy details</sys:String>
    <sys:String x:Key="Str_Crash_OpenIssue">Open GitHub issue</sys:String>
    <sys:String x:Key="Str_Crash_Close">Close</sys:String>
    <sys:String x:Key="Str_Crash_Copied">Details copied to clipboard</sys:String>

