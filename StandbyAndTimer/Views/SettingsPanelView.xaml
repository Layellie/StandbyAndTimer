<UserControl x:Class="StandbyAndTimer.Views.SettingsPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:StandbyAndTimer.Views.Converters"
             xmlns:cards="clr-namespace:StandbyAndTimer.Views.Cards"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             FontFamily="{StaticResource AppFont}" FontSize="13">

    <UserControl.Resources>
        <conv:LanguageDisplayConverter x:Key="LangConv"/>
        <conv:ThemeDisplayConverter    x:Key="ThemeConv"/>
        <BooleanToVisibilityConverter  x:Key="BoolToVis"/>

        <!-- Hotkey pill: shows the combo; while its row is recording (Tag =
             IsRecordingX = true) it swaps to the "press keys" prompt in an
             accent outline. Explicit TextBlocks so the app-level implicit
             TextBlock style can't override size/colour. -->
        <Style x:Key="HotkeyButtonStyle" TargetType="Button">
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ToolTip"          Value="{DynamicResource Str_Settings_HotkeyClickToChange}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="Transparent"
                                BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusSmall}"
                                Padding="7,2"
                                MinWidth="72"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <TextBlock x:Name="combo"
                                           Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppFg}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="prompt"
                                           Text="{DynamicResource Str_Settings_HotkeyRecording}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentText}"
                                           HorizontalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
                                <Setter TargetName="bd" Property="Background"  Value="{DynamicResource HoverBg}"/>
                            </Trigger>
                            <!-- Property trigger on the button's own Tag, with a
                                 typed value: Tag is object, so a plain
                                 Value="True" stays a string and never equals
                                 the bound bool. -->
                            <Trigger Property="Tag">
                                <Trigger.Value>
                                    <sys:Boolean>True</sys:Boolean>
                                </Trigger.Value>
                                <Setter TargetName="bd"     Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
                                <Setter TargetName="bd"     Property="Background"  Value="{DynamicResource AccentSubtle}"/>
                                <Setter TargetName="combo"  Property="Visibility"  Value="Collapsed"/>
                                <Setter TargetName="prompt" Property="Visibility"  Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Settings TAB page. WhichGPU-style: small section label above a
         grouped card of rows, title (+ optional description) on the left,
         control on the right.

         ONE grid for both columns, rows shared: label / card pairs sit on
         the same rows, so left and right cards start and end on the same
         line (each card stretches to the taller one of its row). The last
         row is * : Hotkeys (left) and the log viewer (right) both run to the
         bottom of the page.

         No ScrollViewer: every row has a known intrinsic height that fits
         the fixed 760x520 window; only the log text scrolls internally. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 0 Startup | Notifications labels -->
            <RowDefinition Height="Auto"/>  <!-- 1 Startup | Notifications cards -->
            <RowDefinition Height="Auto"/>  <!-- 2 Appearance | Backup labels -->
            <RowDefinition Height="Auto"/>  <!-- 3 Appearance | Backup cards -->
            <RowDefinition Height="Auto"/>  <!-- 4 Hotkeys | Recent logs labels -->
            <RowDefinition Height="*"/>     <!-- 5 Hotkeys | Recent logs (fill) -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════ ROW 0-1: STARTUP | NOTIFICATIONS ═══════════════════ -->
        <TextBlock Grid.Row="0" Grid.Column="0"
                   Text="{DynamicResource Str_Settings_StartupSection}"
                   Style="{StaticResource PageSectionLabelStyle}"/>
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource SettingsGroupStyle}">
            <StackPanel>
                <Grid Margin="0,2,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="{DynamicResource Str_Settings_LaunchOnStartup}"
                                   Style="{StaticResource SettingTitleStyle}"/>
                        <TextBlock Text="{DynamicResource Str_Settings_LaunchOnStartupDesc}"
                                   Style="{StaticResource SettingDescStyle}"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1"
                              IsChecked="{Binding AutoStartEnabled}"
                              Style="{StaticResource ToggleSwitchStyle}"/>
                </Grid>

                <Grid Margin="0,6,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="{DynamicResource Str_Settings_CheckUpdateOnStartup}"
                                   Style="{StaticResource SettingTitleStyle}"/>
                        <TextBlock Text="{DynamicResource Str_Settings_CheckUpdateOnStartupDesc}"
                                   Style="{StaticResource SettingDescStyle}"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1"
                              IsChecked="{Binding UpdateCheckEnabled}"
                              Style="{StaticResource ToggleSwitchStyle}"/>
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="0" Grid.Column="2"
                   Text="{DynamicResource Str_Settings_NotificationsSection}"
                   Style="{StaticResource PageSectionLabelStyle}"/>
        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource SettingsGroupStyle}">
            <!-- Rows centred in the card: it is stretched to the Startup card
                 height, so top-aligned rows would leave a gap underneath. -->
            <StackPanel VerticalAlignment="Center">
                <Grid Margin="0,2,0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Str_Settings_NotifyOnPurge}"
                               Style="{StaticResource SettingTitleStyle}"
                               VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1"
                              IsChecked="{Binding NotifyOnPurge}"
                              Style="{StaticResource ToggleSwitchStyle}"/>
                </Grid>
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Str_Settings_NotifyOnTimer}"
                               Style="{StaticResource SettingTitleStyle}"
                               VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1"
                              IsChecked="{Binding NotifyOnTimerToggle}"
                              Style="{StaticResource ToggleSwitchStyle}"/>
                </Grid>
                <!-- Covers both game balloons: a game auto-added to the list,
                     and a listed game starting. -->
                <Grid Margin="0,3,0,2"
                      Background="Transparent"
                      ToolTip="{DynamicResource Str_Settings_NotifyOnGameTip}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Str_Settings_NotifyOnGame}"
                               Style="{StaticResource SettingTitleStyle}"
                               VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1"
                              IsChecked="{Binding NotifyOnGameDetected}"
                              Style="{StaticResource ToggleSwitchStyle}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ═══════════════════ ROW 2-3: APPEARANCE | BACKUP ═══════════════════ -->
        <TextBlock Grid.Row="2" Grid.Column="0"
                   Text="{DynamicResource Str_Settings_AppearanceSection}"
                   Style="{StaticResource PageSectionLabelStyle}"/>
        <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource SettingsGroupStyle}">
            <StackPanel VerticalAlignment="Center">
                <Grid Margin="0,2,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{DynamicResource Str_Settings_Language}"
                               Style="{StaticResource SettingTitleStyle}"
                               VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding LanguageOptions}"
                              SelectedItem="{Binding SelectedLanguage}"
                              Style="{StaticResource SettingsComboBoxStyle}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource LangConv}}"
                                           Foreground="{DynamicResource InputFg}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <Grid Margin="0,4,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{DynamicResource Str_Settings_Theme}"
                               Style="{StaticResource SettingTitleStyle}"
                               VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding ThemeOptions}"
                              SelectedItem="{Binding SelectedTheme}"
                              Style="{StaticResource SettingsComboBoxStyle}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource ThemeConv}}"
                                           Foreground="{DynamicResource InputFg}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Update / import / auto-start status sits on the label row, right
             of the label, one line, trimmed (full text in the tooltip). In
             the card it grew the shared row and pushed the Hotkeys card past
             the bottom of the fixed window. -->
        <Grid Grid.Row="2" Grid.Column="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource Str_Settings_BackupSection}"
                       Style="{StaticResource PageSectionLabelStyle}"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding UpdateStatus}"
                       ToolTip="{Binding UpdateStatus}"
                       Foreground="{DynamicResource AppFgDim}"
                       FontSize="11"
                       TextTrimming="CharacterEllipsis"
                       HorizontalAlignment="Right"
                       Margin="12,0,2,6"/>
        </Grid>
        <!-- Buttons: Padding 6,0 — the default 10,5 left a 16 px content
             box inside a bordered 28 px button, clipping descenders by
             1 px, and was 4 px short for "Güncellemeleri Kontrol Et". -->
        <Border Grid.Row="3" Grid.Column="2" Style="{StaticResource SettingsGroupStyle}" Padding="10">
            <StackPanel VerticalAlignment="Center">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" Grid.Column="0"
                            Content="{DynamicResource Str_Settings_Export}"
                            Command="{Binding ExportSettingsCommand}"
                            Style="{StaticResource GhostButtonStyle}"
                            Height="28" Padding="6,0"/>
                    <Button Grid.Row="0" Grid.Column="2"
                            Content="{DynamicResource Str_Settings_Import}"
                            Command="{Binding ImportSettingsCommand}"
                            Style="{StaticResource GhostButtonStyle}"
                            Height="28" Padding="6,0"/>
                    <!-- Check for updates and Download & Install share this
                         cell: the latter replaces the former once an update
                         is found, so the card never grows a row. -->
                    <Button Grid.Row="2" Grid.Column="0"
                            Content="{DynamicResource Str_Settings_CheckUpdate}"
                            Command="{Binding CheckUpdateCommand}"
                            Height="28" Padding="6,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource DarkButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UpdateAvailable}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Grid.Row="2" Grid.Column="0"
                            Content="{DynamicResource Str_Settings_DownloadInstall}"
                            Command="{Binding DownloadAndInstallCommand}"
                            Style="{StaticResource DarkButtonStyle}"
                            Height="28" Padding="6,0"
                            Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}"/>
                    <Button Grid.Row="2" Grid.Column="2"
                            Content="{DynamicResource Str_Settings_OpenLog}"
                            Command="{Binding OpenLogFolderCommand}"
                            Style="{StaticResource GhostButtonStyle}"
                            Height="28" Padding="6,0"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ═══════════════════ ROW 4-5: HOTKEYS | RECENT LOGS ═══════════════════ -->
        <!-- Hotkeys: click a pill, press the new combo (Esc cancels). Key
             capture lives in the code-behind (OnPreviewKeyDown); the rules
             and registration in SettingsViewModel. -->
        <!-- Why the last combo was rejected: on the label row, right of the
             label (same reason as the Backup status — the card has no spare
             height with three hotkey rows). -->
        <Grid Grid.Row="4" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource Str_Settings_HotkeysSection}"
                       Style="{StaticResource PageSectionLabelStyle}"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding HotkeyError}"
                       ToolTip="{Binding HotkeyError}"
                       Foreground="{DynamicResource DangerColor}"
                       FontSize="11"
                       TextTrimming="CharacterEllipsis"
                       HorizontalAlignment="Right"
                       Margin="12,0,2,6"/>
        </Grid>
        <Border Grid.Row="5" Grid.Column="0" Style="{StaticResource SettingsGroupStyle}" Margin="0">
            <StackPanel>
                <Grid Margin="0,2,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Str_Settings_HotkeyPurge}"
                               Style="{StaticResource SettingTitleStyle}"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Style="{StaticResource HotkeyButtonStyle}"
                            Content="{Binding PurgeHotkeyText}"
                            Tag="{Binding IsRecordingPurge}"
                            Command="{Binding StartHotkeyRecordingCommand}"
                            CommandParameter="purge"/>
                </Grid>

                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Str_Settings_HotkeyTimer}"
                               Style="{StaticResource SettingTitleStyle}"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Style="{StaticResource HotkeyButtonStyle}"
                            Content="{Binding TimerHotkeyText}"
                            Tag="{Binding IsRecordingTimer}"
                            Command="{Binding StartHotkeyRecordingCommand}"
                            CommandParameter="timer"/>
                </Grid>

                <Grid Margin="0,4,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Str_Settings_HotkeyAutoPurge}"
                               Style="{StaticResource SettingTitleStyle}"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Style="{StaticResource HotkeyButtonStyle}"
                            Content="{Binding AutoPurgeHotkeyText}"
                            Tag="{Binding IsRecordingAutoPurge}"
                            Command="{Binding StartHotkeyRecordingCommand}"
                            CommandParameter="autopurge"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Recent logs: the header sits on the label row like every other
             section (the Refresh button is pulled up 3 px so the row stays
             label height); the viewer card fills row 5. -->
        <Grid Grid.Row="4" Grid.Column="2">
            <TextBlock Text="{DynamicResource Str_Settings_LogsSection}"
                       Style="{StaticResource PageSectionLabelStyle}"/>
            <Button Content="{DynamicResource Str_Settings_LogsRefresh}"
                    Command="{Binding RefreshLogsCommand}"
                    Style="{StaticResource GhostButtonStyle}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Height="20"
                    Padding="10,0"
                    FontSize="10"
                    Margin="0,-3,0,4"/>
        </Grid>
        <cards:LogsViewerCard Grid.Row="5" Grid.Column="2"/>
    </Grid>
</UserControl>
