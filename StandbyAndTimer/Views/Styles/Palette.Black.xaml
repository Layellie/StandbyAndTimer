<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Black palette — the Dark palette with every surface (page, cards,
         dialogs, inputs) on Dark's page colour #0E0F11. Cards are told apart
         by their borders only, so BorderColor/InputBorder are a step
         brighter than in Dark. WCAG contrast on #0E0F11: AppFg 17.6:1,
         AppFgDim 10.4:1, AccentText 14.2:1. -->
    <SolidColorBrush x:Key="AppBg"            Color="#0E0F11"/>
    <SolidColorBrush x:Key="SurfaceBg"        Color="#0E0F11"/>
    <SolidColorBrush x:Key="Surface2Bg"       Color="#0E0F11"/>
    <SolidColorBrush x:Key="AppFg"            Color="#F3F5F8"/>
    <SolidColorBrush x:Key="AppFgDim"         Color="#B9BFC8"/>
    <!-- Non-text only (scrollbar thumb, toggle-off track) -->
    <SolidColorBrush x:Key="AppFgMuted"       Color="#6A717B"/>
    <SolidColorBrush x:Key="AccentPrimary"    Color="#B8F03A"/>
    <SolidColorBrush x:Key="AccentHover"      Color="#C8F75A"/>
    <SolidColorBrush x:Key="AccentPressed"    Color="#98C92E"/>
    <SolidColorBrush x:Key="AccentSubtle"     Color="#1F2E0A"/>
    <SolidColorBrush x:Key="AccentOnText"     Color="#0A140A"/>
    <SolidColorBrush x:Key="AccentText"       Color="#B8F03A"/>
    <SolidColorBrush x:Key="InputBg"          Color="#0E0F11"/>
    <SolidColorBrush x:Key="InputFg"          Color="#E9ECF0"/>
    <SolidColorBrush x:Key="InputBorder"      Color="#3A3F46"/>
    <SolidColorBrush x:Key="InputFocusBorder" Color="#B8F03A"/>
    <SolidColorBrush x:Key="BorderColor"      Color="#30343A"/>
    <SolidColorBrush x:Key="SeparatorBrush"   Color="#25282D"/>
    <SolidColorBrush x:Key="SelectionBg"      Color="#2E4515"/>
    <SolidColorBrush x:Key="SelectionFg"      Color="#F3F5F8"/>
    <SolidColorBrush x:Key="HoverBg"          Color="#1A1C20"/>
    <SolidColorBrush x:Key="SuccessColor"     Color="#B8F03A"/>
    <SolidColorBrush x:Key="DangerColor"      Color="#F87171"/>

    <SolidColorBrush x:Key="ModalOverlayBrush" Color="#C00E0F11"/>

    <!-- Title bar DWM mode hint: 1 = dark, 0 = light (used by MainWindow) -->
    <sys:Int32 x:Key="DwmDarkMode" xmlns:sys="clr-namespace:System;assembly=System.Runtime">1</sys:Int32>

</ResourceDictionary>
