<UserControl x:Class="StandbyAndTimer.Views.Overlays.InstalledGamesOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:StandbyAndTimer.Views.Converters"
             FontFamily="{StaticResource AppFont}" FontSize="13">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:GameIconConverter x:Key="GameIconConv"/>
    </UserControl.Resources>

    <!-- Installed games picker (DataContext = MainViewModel). Scans Steam and
         Epic Games libraries and adds ticked executables to Game Mode. -->
    <Border Background="{DynamicResource ModalOverlayBrush}"
            Visibility="{Binding IsInstalledGamesVisible, Converter={StaticResource BoolToVis}}">
        <Border.InputBindings>
            <MouseBinding MouseAction="LeftClick" Command="{Binding CloseInstalledGamesCommand}"/>
        </Border.InputBindings>
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource Surface2Bg}" BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1" CornerRadius="{StaticResource RadiusLarge}"
                Padding="22,18,22,16" Width="560" Height="440"
                MouseLeftButtonDown="DialogMouseDown"
                DataContext="{Binding InstalledGamesDialog}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" Fill="{DynamicResource AccentPrimary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{DynamicResource Str_Scan_Title}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AppFg}"/>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource Str_Scan_Subtitle}" FontSize="12" Foreground="{DynamicResource AppFgDim}" Margin="17,0,0,0"/>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{DynamicResource Str_Dl_All}"  Command="{Binding SelectAllCommand}"  Style="{StaticResource GhostButtonStyle}" Height="26" Padding="10,0" MinWidth="80" Margin="0,0,6,0"/>
                        <Button Content="{DynamicResource Str_Dl_None}" Command="{Binding SelectNoneCommand}" Style="{StaticResource GhostButtonStyle}" Height="26" Padding="10,0" MinWidth="80"/>
                    </StackPanel>
                    <TextBlock Text="{Binding SelectedText}" FontSize="12" Foreground="{DynamicResource AppFgDim}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <Border Grid.Row="2" Style="{StaticResource SettingsGroupStyle}" Margin="0" Padding="6,4">
                    <Grid>
                        <TextBlock Text="{Binding Message}" FontSize="12" Foreground="{DynamicResource AppFgDim}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <ListBox ItemsSource="{Binding Items}"
                                 Background="Transparent" BorderThickness="0"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsChecked}"
                                                  IsEnabled="{Binding CanSelect}"
                                                  Style="{StaticResource DarkCheckBoxStyle}"
                                                  VerticalAlignment="Center"/>
                                        <Image Grid.Column="1"
                                               Source="{Binding ExecutablePath, Converter={StaticResource GameIconConv}}"
                                               Width="16" Height="16"
                                               Margin="2,0,4,0"
                                               VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Name}"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding ExecutablePath}"
                                                   VerticalAlignment="Center"/>
                                        <Border Grid.Column="3"
                                                Style="{StaticResource MutedBadgeStyle}"
                                                Padding="6,1"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusBadge}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AppFgDim}"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Grid Grid.Row="3" Margin="0,12,0,0">
                    <Button Content="{DynamicResource Str_Dl_Close}"
                            Command="{Binding DataContext.CloseInstalledGamesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Left" MinWidth="80" Height="30"/>
                    <Button Content="{DynamicResource Str_Scan_AddSelected}" Command="{Binding AddSelectedCommand}"
                            Style="{StaticResource DarkButtonStyle}" HorizontalAlignment="Right" MinWidth="160" Height="30"/>
                </Grid>
            </Grid>
        </Border>
    </Border>
</UserControl>
