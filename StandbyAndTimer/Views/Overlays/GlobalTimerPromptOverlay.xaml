<UserControl x:Class="StandbyAndTimer.Views.Overlays.GlobalTimerPromptOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFont}" FontSize="13">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="PromptTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="LineHeight"   Value="17"/>
            <Setter Property="Foreground"   Value="{DynamicResource AppFgDim}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin"       Value="0,0,0,8"/>
        </Style>
    </UserControl.Resources>

    <!-- Asked once at start-up (after the first-run wizard), Windows 11
         only, and only while the switch is off. It needs an answer, so the
         dim overlay does not close it. Same texts as the System settings
         panel, which is where it can be changed later. -->
    <Border Background="{DynamicResource ModalOverlayBrush}"
            Visibility="{Binding SystemSettings.IsPromptVisible, Converter={StaticResource BoolToVis}}">
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource Surface2Bg}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusLarge}"
                Padding="22,18"
                Width="440">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Ellipse Width="9" Height="9"
                             Fill="{DynamicResource AccentPrimary}"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0"/>
                    <TextBlock Text="{DynamicResource Str_GlobalPrompt_Title}"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppFg}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="{DynamicResource Str_System_GlobalTimerDesc1}" Style="{StaticResource PromptTextStyle}"/>
                <TextBlock Text="{DynamicResource Str_System_GlobalTimerDesc2}" Style="{StaticResource PromptTextStyle}"/>
                <TextBlock Text="{DynamicResource Str_System_GlobalTimerDesc3}" Style="{StaticResource PromptTextStyle}"/>
                <TextBlock Text="{DynamicResource Str_GlobalPrompt_Later}" Style="{StaticResource PromptTextStyle}"
                           Foreground="{DynamicResource AppFg}" Margin="0,2,0,16"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Content="{DynamicResource Str_GlobalPrompt_No}"
                            Command="{Binding SystemSettings.DeclinePromptCommand}"
                            Style="{StaticResource GhostButtonStyle}"
                            Height="32"/>
                    <Button Grid.Column="2"
                            Content="{DynamicResource Str_GlobalPrompt_Yes}"
                            Command="{Binding SystemSettings.AcceptPromptCommand}"
                            Style="{StaticResource DarkButtonStyle}"
                            Height="32"/>
                </Grid>
            </StackPanel>
        </Border>
    </Border>
</UserControl>
