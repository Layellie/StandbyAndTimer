<UserControl x:Class="StandbyAndTimer.Views.Overlays.PurgeHistoryOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFont}" FontSize="13">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <!-- Purge history, opened from the Purges count on the Standby memory
         card: time, kind (+ trigger) and how much each purge freed, newest
         first, this session. The dim overlay closes it; clicks inside do not. -->
    <Border Background="{DynamicResource ModalOverlayBrush}"
            Visibility="{Binding IsPurgeHistoryVisible, Converter={StaticResource BoolToVis}}">
        <Border.InputBindings>
            <MouseBinding MouseAction="LeftClick" Command="{Binding ClosePurgeHistoryCommand}"/>
        </Border.InputBindings>
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource Surface2Bg}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusLarge}"
                Padding="22,18"
                Width="440"
                MaxHeight="440"
                MouseLeftButtonDown="DialogMouseDown">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9"
                                 Fill="{DynamicResource AccentPrimary}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0"/>
                        <TextBlock Text="{DynamicResource Str_History_Title}"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppFg}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource Str_History_Subtitle}"
                               FontSize="12"
                               Foreground="{DynamicResource AppFgDim}"
                               Margin="17,0,0,0"/>
                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource SettingsGroupStyle}" Margin="0" Padding="12,6">
                    <Grid>
                        <TextBlock x:Name="Empty"
                                   Text="{DynamicResource Str_History_Empty}"
                                   FontSize="12"
                                   Foreground="{DynamicResource AppFgDim}"
                                   Margin="0,6">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PurgeHistory.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Focusable="False">
                            <ItemsControl ItemsSource="{Binding PurgeHistory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Time}" FontSize="12"
                                                       Foreground="{DynamicResource AppFgDim}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding What}" FontSize="12"
                                                       Foreground="{DynamicResource AppFg}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Freed}" FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentText}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Button Grid.Row="2"
                        Content="{DynamicResource Str_History_Close}"
                        Command="{Binding ClosePurgeHistoryCommand}"
                        Style="{StaticResource DarkButtonStyle}"
                        HorizontalAlignment="Right"
                        MinWidth="80" Height="30"
                        Margin="0,14,0,0"/>
            </Grid>
        </Border>
    </Border>
</UserControl>
