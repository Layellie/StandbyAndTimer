<?xml version="1.0" encoding="utf-8"?>
<!--
  Single-file self-contained publish profile.
  Usage:  dotnet publish StandbyAndTimer.csproj -p:PublishProfile=win-x64-single
  Output: bin\publish\win-x64\StandbyAndTimer.exe (~190 MB uncompressed;
  the installer compresses it)
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\publish\win-x64\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Off: a compressed bundle is unpacked into private memory at every
         start (assemblies cannot be mapped from the file). Measured in the
         tray: 220 MB private compressed vs 143 MB uncompressed. Inno Setup
         compresses the exe anyway, so the download barely changes. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
