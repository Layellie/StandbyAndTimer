<?xml version="1.0" encoding="utf-8"?>
<!--
  Self-contained publish profile: the exe with its DLLs in one folder.
  Usage:  dotnet publish StandbyAndTimer.csproj -p:PublishProfile=win-x64
  Output: bin\publish\win-x64\ (about 475 files, 175 MB; the installer
  compresses them into one setup exe)

  Not a single-file bundle (it was one up to 3.0.8), for two reasons:
  - Start-up. A bundle is processed by the host before any code runs: an
    empty WPF window reached Main after 700 ms as a bundle and after 72 ms
    as a folder. The app itself, same code, visible start-up: 1266 ms as a
    bundle, 624 ms as a folder; in the tray 68.5 -> 63.8 MB private memory.
  - Safety. A bundle unpacks its native DLLs (wpfgfx, PresentationNative,
    D3DCompiler, ...) to %TEMP%\.net\StandbyAndTimer and loads them from
    there at every start. That folder is writable by any program of the
    user, and this app runs elevated. From a folder everything is loaded
    from the install directory, which only administrators can write.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\publish\win-x64\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
