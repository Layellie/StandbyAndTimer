<Window x:Class="StandbyAndTimer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:StandbyAndTimer.Views"
        xmlns:cards="clr-namespace:StandbyAndTimer.Views.Cards"
        xmlns:overlays="clr-namespace:StandbyAndTimer.Views.Overlays"
        xmlns:conv="clr-namespace:StandbyAndTimer.Views.Converters"
        Title="StandbyAndTimer"
        Width="760"
        Height="520"
        ResizeMode="CanMinimize"
        WindowStyle="None"
        Background="{DynamicResource AppBg}"
        Foreground="{DynamicResource AppFg}"
        FontFamily="{StaticResource AppFont}"
        FontSize="13"
        UseLayoutRounding="True">

    <!-- UseLayoutRounding: snap every layout slot to whole pixels so centered
         content never lands on half pixels. (It did NOT fix the faint lines
         inside the number inputs; those were anti-aliased ScrollViewer clip
         edges, fixed with RenderOptions.EdgeMode in the templates.) -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Views/Styles/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Outer container with a 1px border so the borderless window still has a visible edge -->
    <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Background="{DynamicResource AppBg}">

        <!-- Root grid: title bar + tabbed content + status strip + overlays -->
        <Grid x:Name="RootGrid" ClipToBounds="True">
            <Grid.RowDefinitions>
                <!-- Row 0 = title bar, locked to 36 px so nothing in the
                     content or overlay layers can inflate it. -->
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══════════════════ TITLE BAR ═══════════════════ -->
            <cards:TitleBar Grid.Row="0"
                            MinimizeRequested="OnTitleBarMinimize"
                            CloseRequested="OnTitleBarClose"/>

            <!-- ═══════════════════ TABBED CONTENT ═══════════════════
                 Three fixed-size pages, none scrolls. SelectedIndex is bound
                 to MainViewModel.SelectedTab (0 Status, 1 Maintenance,
                 2 Settings), which keeps Settings.IsOpen (log-tail refresh)
                 and Maintenance.IsActive (scan on selection) in step. -->
            <TabControl Grid.Row="1"
                        Margin="14,12,14,0"
                        Style="{StaticResource SegmentTabControlStyle}"
                        ItemContainerStyle="{StaticResource SegmentTabItemStyle}"
                        SelectedIndex="{Binding SelectedTab, Mode=TwoWay}">

                <TabItem Header="{DynamicResource Str_Tab_Status}">
                    <!-- Three columns: Timer + Memory | Purge | Game Mode.
                         Game Mode takes the full column height so the
                         game list gets real room instead of a 60 px strip. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Timer and Standby memory share the column equally
                             (two * rows): with Auto + * the Timer card was its
                             content height and the memory card took the rest,
                             so the two were visibly uneven. -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <cards:TimerCard Grid.Row="0"/>
                            <cards:MemoryStatsCard Grid.Row="2"/>
                        </Grid>

                        <cards:StandbyPurgeCard Grid.Column="2"/>
                        <cards:GameModeCard Grid.Column="4" GameDropped="OnGameDropped" GameLaunchRequested="OnGameLaunchRequested"/>
                    </Grid>
                </TabItem>

                <!-- Built only while selected (ContentTemplate), DataContext =
                     Content = MainViewModel.Maintenance. Costs nothing at start-up. -->
                <TabItem Header="{DynamicResource Str_Tab_Maintenance}" Content="{Binding Maintenance}">
                    <TabItem.ContentTemplate>
                        <DataTemplate>
                            <views:MaintenancePanelView/>
                        </DataTemplate>
                    </TabItem.ContentTemplate>
                </TabItem>

                <TabItem Header="{DynamicResource Str_Tab_Settings}">
                    <views:SettingsPanelView DataContext="{Binding Settings}"/>
                </TabItem>
            </TabControl>

            <!-- ═══════════════════ STATUS STRIP ═══════════════════ -->
            <cards:StatusBar Grid.Row="2" Margin="14,0,14,8"/>

            <!-- ═══════════════════ MODAL OVERLAYS ═══════════════════ -->
            <overlays:AboutOverlay  Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="18"/>
            <overlays:WizardOverlay Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="19"/>
            <overlays:SystemOverlay Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="18"/>
            <overlays:PurgeHistoryOverlay Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="18"/>
            <!-- The two Maintenance dialogs are built when opened and dropped when
                 closed (Content + template set only while visible): built at
                 start-up they cost ~30 ms before the window was on screen. -->
            <ContentControl Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="18" Focusable="False">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Maintenance.IsDownloadsVisible}" Value="True">
                                <Setter Property="Content" Value="{Binding Maintenance}"/>
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate><overlays:DownloadsOverlay/></DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
            <ContentControl Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="18" Focusable="False">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Maintenance.IsHistoryVisible}" Value="True">
                                <Setter Property="Content" Value="{Binding Maintenance}"/>
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate><overlays:CleanupHistoryOverlay/></DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
            <overlays:GlobalTimerPromptOverlay Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="19"/>
            <overlays:CloseConfirmationOverlay x:Name="CloseDialog"
                                               Grid.Row="0" Grid.RowSpan="3"
                                               Panel.ZIndex="20"
                                               MinimizeRequested="OnCloseDialogMinimize"
                                               ExitRequested="OnCloseDialogExit"/>
        </Grid>
    </Border>
</Window>
