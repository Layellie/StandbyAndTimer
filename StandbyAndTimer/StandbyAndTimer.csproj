<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app_icon.ico</ApplicationIcon>
    <AssemblyTitle>StandbyAndTimer</AssemblyTitle>
    <AssemblyName>StandbyAndTimer</AssemblyName>
    <RootNamespace>StandbyAndTimer</RootNamespace>
    <Company>LAYE77IE</Company>
    <Authors>LAYE77IE</Authors>
    <Product>StandbyAndTimer</Product>
    <Copyright>Copyright © LAYE77IE</Copyright>
    <!-- Baseline version embedded in dev / CI builds. The release pipeline
         passes -p:Version=X.Y.Z to dotnet publish, which overrides this so
         the binary on GitHub Releases always carries the right tag. Without
         this default, dev builds defaulted to AssemblyVersion 1.0.0.0 and
         the in-app update checker reported a phantom "new version" against
         the current release. -->
    <Version>3.0.8</Version>
  </PropertyGroup>

  <!--
    Runtime settings for an app that sits in the tray. Measured in the tray,
    two runs each, 30 to 60 s after a hidden start (this build against the
    same build without them): private memory 70.8 -> 68.0 MB, private working
    set 13.7 -> 11.6 MB, CPU in that first minute 0.65 % -> 0.08 % of one core,
    hidden start-up unchanged (344 -> 333 ms).
    - TieredPGO off: the JIT no longer instruments and re-compiles the hot
      methods (the once-a-second tick) to profile them; the pre-compiled
      (ReadyToRun) code is fast enough for what this app does.
    - Concurrent GC off: no background GC thread and its bookkeeping; the
      heap is a few MB, so a blocking collection takes about a millisecond.
    TieredCompilation off saved more (66.3 MB) but cost about 25 ms at
    start-up, so it stays on.
  -->
  <PropertyGroup>
    <TieredPGO>false</TieredPGO>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="app_icon.ico" />
  </ItemGroup>

  <!--
    UseWindowsForms=true is enabled so we can use System.Windows.Forms.NotifyIcon
    (most reliable tray-icon API). Globally hide its namespace so WPF's
    Application / UserControl / etc. don't become ambiguous; the one file that
    needs WinForms types uses the `WinForms` alias instead.
  -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
  </ItemGroup>

  <!-- Unit tests reach internal view-model and service members.
       Nothing else uses this. -->
  <ItemGroup>
    <InternalsVisibleTo Include="StandbyAndTimer.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app_icon.ico" />
  </ItemGroup>

</Project>
